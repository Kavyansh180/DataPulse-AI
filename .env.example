# ==============================================================================
# DataPulse AI - Environment Configuration Example
# Copy this file to .env and replace placeholders with your actual credentials.
# NEVER commit the active .env file to version control.
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
DEBUG=True
APP_NAME="DataPulse AI"
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# File Upload & Profiling Limits
MAX_UPLOAD_SIZE_BYTES=52428800
MAX_ROW_COUNT_LIMIT=1000000

# Amazon S3 Storage Configuration (Optional for local test execution)
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-datapulse-bucket
# S3_ENDPOINT_URL=http://localhost:4566  # Optional: For LocalStack / MinIO

# Database Configuration (Neon PostgreSQL)
# Example Neon Connection String format:
# postgresql://<user>:<password>@<ep-pooler-id>.us-east-2.aws.neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgresql://your_user:your_password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Database Connection Pool Tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# AI Root-Cause Analysis (LLM Integration)
LLM_PROVIDER=openai
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=gpt-4o-mini
# LLM_API_BASE=https://api.openai.com/v1  # Optional: For Groq, OpenRouter, or local vLLM/Ollama
LLM_TIMEOUT_SECONDS=30.0

# Dashboard API Client Configuration
# Deployed AWS Production API Gateway base URL or local backend fallback
DATAPULSE_API_URL=https://e3bllh77q4.execute-api.ap-south-1.amazonaws.com

# JWT Authentication & Cryptographic Security
# In production, provide a cryptographically random 256-bit secret via AWS Secrets Manager, SSM SecureString, or environment.
JWT_SECRET_KEY=change-this-in-production-use-a-strong-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30


